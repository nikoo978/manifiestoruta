# Clave gratuita de Google AI Studio. Nunca usar NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Alternativa opcional; AI Gateway puede exigir una tarjeta.
AI_GATEWAY_API_KEY=

# Persistencia opcional.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Maps JavaScript API. Es pública por diseño: restringirla por dominio y API en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ID de mapa vectorial propio (recomendado). Si se omite, la app usa DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Dibuja recorridos reales por calles con Routes API. Usar "false" para dejar sólo la línea estimada.
NEXT_PUBLIC_GOOGLE_MAPS_ROUTES_ENABLED=true
